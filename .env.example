# ─── App ───────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

# ─── Security / Crypto ─────────────────────────────────
# JWT signing secret (use a long random string). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# AES-256-GCM master key, 32 bytes base64-encoded. Generate:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CRYPTO_MASTER_KEY=change-me-base64-32-bytes

# ─── Postgres (local docker) ───────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
DATABASE_URL=postgresql+psycopg://rag:ragpass@localhost:5432/ragdb

# ─── Supabase (users/auth) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── Qdrant ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# ─── Storage ───────────────────────────────────────────
# Where encrypted uploaded blobs live (local for now)
BLOB_STORE_DIR=./data/blobs

# ─── LLM providers (fallback order: groq -> cerebras) ──
LLM_PROVIDER_ORDER=["groq","cerebras"]
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# ─── Embeddings (fallback order: voyage -> gemini) ─────
EMBEDDING_PROVIDER_ORDER=["voyage","gemini"]
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
GEMINI_API_KEY=
# gemini-embedding-001 supports outputDimensionality -> match EMBEDDING_DIM (1024)
GEMINI_EMBED_MODEL=gemini-embedding-001

# ─── STT (fallback order: deepgram -> groq whisper) ───
STT_PROVIDER_ORDER=["deepgram","groq"]
DEEPGRAM_API_KEY=

# ─── TTS (Cartesia voice ID: console.cartesia.ai → Voices) ────────────────
# Default voice: "a0e99841-438c-4a64-b679-ae501e7d6091" (British Reading)
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_API_KEYS=

# ─── TTS (fallback order: cartesia -> sarvam -> murf) ──
TTS_PROVIDER_ORDER=["cartesia","sarvam","murf"]
SARVAM_API_KEY=
MURF_API_KEY=

# ─── Neo4j Knowledge Graph ─────────────────────────────────────────────────────
# AuraDB free instance: console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ─── Tavily Web Search ─────────────────────────────────────────────────────────
# tavily.com → API keys (free: 1000 searches/mo)
TAVILY_API_KEY=tvly-...

# ─── OpenWeatherMap Ambient Context ────────────────────────────────────────────
# openweathermap.org → API keys (free tier)
OPENWEATHERMAP_API_KEY=

# ─── Apify (URL crawling into RAG) ────────────────────────────────────────────
# console.apify.com → Settings → Integrations → API tokens
APIFY_API_KEY=apify_api_...

# ─── Admin / signup approval ──────────────────────────────────────────────────
# Only ADMIN_EMAIL is auto-approved; everyone else starts "pending" and must be
# approved. Set REQUIRE_APPROVAL=false to auto-approve all signups (dev/demo).
ADMIN_EMAIL=
REQUIRE_APPROVAL=true
APP_BASE_URL=http://localhost:8000

# ─── Email (Resend — approval-request notifications) ──────────────────────────
# resend.com free tier; needed only to email yourself the approval link.
RESEND_API_KEY=
